{
  "name": "video-player",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently --kill-others \"npm run build:dev\" \"npm run watch:css\" \"npm run start:dev\"",
    "dev:all": "concurrently -k -n \"server,webpack,tailwind,frontend\" -c \"magenta,cyan,blue,green\" \"npm run server\" \"npm run build:dev\" \"npm run watch:css\" \"npm run start:dev\"",
    "server": "tsx server/index.ts",
    "test": "tsx --test tests/Config.test.ts tests/State.test.ts tests/VideoApi.test.ts",
    "build:dev": "webpack --watch --mode development",
    "build:prod": "webpack --mode production",
    "watch:css": "tailwindcss -i ./src/input.css -o ./dist/output.css --watch",
    "build:css": "tailwindcss -i ./src/input.css -o ./dist/output.css --minify",
    "start": "live-server --port=80 --no-browser --ignore=server/prisma/**,tmp_uploads/**,videos/**,node_modules/**",
    "start:dev": "live-server ./ --port=8080 --open=/index.html --wait=200",
    "npx": "tailwindcss init",
    "generate-tags": "tsx src/generate-tag-pages.ts",
    "recognize": "tsx scripts/recognize.ts"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.19.42",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "live-server": "^1.2.2",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.1.1",
    "prisma": "^5.19.1",
    "tailwindcss": "^4.1.11",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^4.9.5",
    "webpack": "^5.92.1",
    "webpack-cli": "^5.1.4"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "@tailwindcss/cli": "^4.1.11",
    "axios": "^1.7.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "form-data": "^4.0.0",
    "google-auth-library": "^9.11.0",
    "multer": "^1.4.5-lts.1",
    "path-browserify": "^1.0.1",
    "sqlite3": "^5.1.7",
    "util": "^0.12.5"
  }
}
